---
import type { Meal } from '../../lib/commerce/types';
import CategoryBadge from './CategoryBadge.astro';
import DietaryBadge from './DietaryBadge.astro';

export interface Props {
  meal: Meal;
}

const { meal } = Astro.props;

const hasBulk = meal.portionOptions && meal.portionOptions.some(p => p.id === 'bulk');
const jsonMeal = JSON.stringify({
  id: meal.id,
  name: meal.name,
  slug: meal.slug,
  image: meal.image,
  price: meal.price,
  calories: meal.calories,
  protein: meal.protein
});
---

<div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-2xl overflow-hidden flex flex-col card-hover-effect group shadow-sm transition-colors">
  <!-- Image Container -->
  <div class="relative aspect-[4/3] bg-gray-100 dark:bg-dark-surface overflow-hidden">
    <img 
      src={meal.image} 
      alt={meal.name}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    
    <!-- Top Badges -->
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none">
      <CategoryBadge category={meal.category} />
      
      {meal.isNew && (
        <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-brand-500 text-white shadow-md">
          NEW
        </span>
      )}
    </div>

    <!-- Quick Macro Overlay -->
    <div class="absolute bottom-3 left-3 right-3 bg-white/90 dark:bg-dark-bg/90 backdrop-blur-md border border-gray-200 dark:border-dark-border rounded-xl p-2 grid grid-cols-4 text-center text-xs shadow-md">
      <div>
        <span class="block text-[10px] text-slate-500 dark:text-gray-400 uppercase font-semibold">Calories</span>
        <span class="font-bold text-slate-900 dark:text-white">{meal.calories}</span>
      </div>
      <div class="border-l border-gray-200 dark:border-dark-border">
        <span class="block text-[10px] text-brand-500 dark:text-brand-400 uppercase font-semibold">Protein</span>
        <span class="font-bold text-brand-500 dark:text-brand-400">{meal.protein}g</span>
      </div>
      <div class="border-l border-gray-200 dark:border-dark-border">
        <span class="block text-[10px] text-amber-600 dark:text-amber-400 uppercase font-semibold">Carbs</span>
        <span class="font-bold text-amber-600 dark:text-amber-400">{meal.carbs}g</span>
      </div>
      <div class="border-l border-gray-200 dark:border-dark-border">
        <span class="block text-[10px] text-slate-500 dark:text-gray-400 uppercase font-semibold">Fat</span>
        <span class="font-bold text-slate-700 dark:text-gray-300">{meal.fat}g</span>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between mb-2">
        <a href={`/menu/${meal.slug}/`} class="hover:text-brand-500 transition-colors">
          <h3 class="font-display font-bold text-lg text-slate-900 dark:text-white leading-snug">
            {meal.name}
          </h3>
        </a>
      </div>

      <p class="text-xs text-slate-600 dark:text-gray-400 line-clamp-2 mb-4 leading-relaxed">
        {meal.description}
      </p>

      <!-- Dietary Badges -->
      <div class="flex flex-wrap gap-1.5 mb-4">
        {meal.dietaryTags.map((tag) => (
          <DietaryBadge tag={tag} />
        ))}
      </div>
    </div>

    <!-- Pricing & Action Bar -->
    <div class="pt-4 border-t border-gray-200 dark:border-dark-border flex items-center justify-between">
      <div>
        <span class="text-xs text-slate-500 dark:text-dark-muted block">Starting at</span>
        <span class="font-display text-xl font-bold text-slate-900 dark:text-white">${meal.price.toFixed(2)}</span>
        {hasBulk && (
          <span class="text-[10px] text-brand-500 dark:text-brand-400 block font-medium">Lean / Bulk Available</span>
        )}
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          class="pin-meal-btn p-2 rounded-xl text-xs text-slate-500 hover:text-brand-500 bg-gray-100 dark:bg-dark-surface cursor-pointer"
          data-meal={jsonMeal}
          title="Pin for Macro Comparison"
        >
          📌
        </button>
        <button
          type="button"
          class="btn-add-to-cart px-4 py-2 rounded-xl text-xs font-bold text-white bg-brand-600 hover:bg-brand-500 shadow-glow-red transition-all cursor-pointer"
          data-meal={jsonMeal}
        >
          + Add
        </button>
      </div>
    </div>
  </div>
</div>
