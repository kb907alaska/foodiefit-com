---
import type { Meal } from '../../lib/commerce/types';

export interface Props {
  meals: Meal[];
}

const { meals } = Astro.props;
---

<div class="bg-dark-card border border-dark-border rounded-2xl p-6 shadow-2xl overflow-hidden">
  <div class="flex items-center justify-between mb-6 pb-4 border-b border-dark-border">
    <div>
      <h3 class="font-display text-xl font-bold text-white uppercase tracking-wide">
        Side-by-Side Macro Comparison
      </h3>
      <p class="text-xs text-gray-400">
        Compare calories, protein density, carbs, and fat across featured Foodie Fit meals.
      </p>
    </div>
    <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-500/10 text-brand-400 border border-brand-500/30">
      Interactive Matrix
    </span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-gray-300">
      <thead>
        <tr class="border-b border-dark-border">
          <th scope="col" class="py-3 px-4 font-bold text-white bg-dark-surface rounded-l-xl">Nutritional Metric</th>
          {meals.map((meal) => (
            <th scope="col" class="py-3 px-4 font-display font-bold text-white text-base min-w-[200px]">
              <div class="flex items-center gap-2">
                <img src={meal.image} alt={meal.name} class="w-8 h-8 rounded-lg object-cover flex-shrink-0" />
                <span class="truncate">{meal.name}</span>
              </div>
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-dark-border">
        <tr>
          <td class="py-3 px-4 font-semibold text-white bg-dark-surface/50">Category</td>
          {meals.map((meal) => (
            <td class="py-3 px-4 uppercase font-bold text-xs text-brand-400">{meal.category}</td>
          ))}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-white bg-dark-surface/50">Starting Price</td>
          {meals.map((meal) => (
            <td class="py-3 px-4 font-bold text-white">${meal.price.toFixed(2)}</td>
          ))}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-white bg-dark-surface/50">Calories</td>
          {meals.map((meal) => (
            <td class="py-3 px-4 font-bold text-white">{meal.calories} kcal</td>
          ))}
        </tr>
        <tr class="bg-brand-950/20">
          <td class="py-3 px-4 font-bold text-brand-400 bg-dark-surface">Protein</td>
          {meals.map((meal) => (
            <td class="py-3 px-4 font-extrabold text-brand-400 text-base">{meal.protein}g</td>
          ))}
        </tr>
        <tr class="bg-amber-950/20">
          <td class="py-3 px-4 font-bold text-amber-400 bg-dark-surface">Carbohydrates</td>
          {meals.map((meal) => (
            <td class="py-3 px-4 font-bold text-amber-400">{meal.carbs}g</td>
          ))}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-white bg-dark-surface/50">Total Fat</td>
          {meals.map((meal) => (
            <td class="py-3 px-4 text-gray-300">{meal.fat}g</td>
          ))}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-white bg-dark-surface/50">Sodium</td>
          {meals.map((meal) => (
            <td class="py-3 px-4 text-gray-300">{meal.sodium ? `${meal.sodium}mg` : 'N/A'}</td>
          ))}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-white bg-dark-surface/50">Dietary Badges</td>
          {meals.map((meal) => (
            <td class="py-3 px-4 text-xs">
              <div class="flex flex-wrap gap-1">
                {meal.dietaryTags.map(t => <span class="bg-dark-surface px-2 py-0.5 rounded border border-dark-border">{t}</span>)}
              </div>
            </td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>
</div>
