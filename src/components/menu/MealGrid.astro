---
import type { Meal } from '../../lib/commerce/types';
import MealCard from './MealCard.astro';

export interface Props {
  meals: Meal[];
}

const { meals } = Astro.props;
---

{meals.length === 0 ? (
  <div class="p-12 text-center bg-dark-card border border-dark-border rounded-2xl">
    <div class="w-16 h-16 rounded-full bg-dark-surface mx-auto flex items-center justify-center text-gray-500 mb-4">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h3 class="font-display text-xl text-white mb-2">No Meals Found</h3>
    <p class="text-gray-400 text-sm max-w-md mx-auto">
      Try adjusting your macro range, category filter, or search query to explore more options.
    </p>
  </div>
) : (
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {meals.map((meal) => (
      <MealCard meal={meal} />
    ))}
  </div>
)}
