---
export interface Props {
  currentCategory?: string;
  currentSearch?: string;
  currentSort?: string;
}

const { currentCategory = 'all' } = Astro.props;

const categories = [
  { id: 'all', name: 'All Menu Items', color: 'bg-gray-400' },
  { id: 'low-carb', name: 'Low Carb (Red)', color: 'bg-red-500' },
  { id: 'active', name: 'Active (Green)', color: 'bg-emerald-500' },
  { id: 'breakfast', name: 'Breakfast (Yellow)', color: 'bg-amber-500' },
  { id: 'snack-dessert', name: 'Snacks & Desserts (Blue)', color: 'bg-blue-500' }
];

const dietaryOptions = [
  { id: 'gluten-free', label: 'Gluten-Free' },
  { id: 'dairy-free', label: 'Dairy-Free' },
  { id: 'high-protein', label: 'High Protein (45g+)' },
  { id: 'keto-friendly', label: 'Keto Friendly' },
  { id: 'nut-free', label: 'Nut-Free' }
];
---

<aside class="bg-dark-card border border-dark-border rounded-2xl p-6 sticky top-28 space-y-8">
  <div class="flex items-center justify-between border-b border-dark-border pb-4">
    <h3 class="font-display font-bold text-lg text-white uppercase tracking-wider flex items-center gap-2">
      <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
      </svg>
      Filter Menu
    </h3>
    <a href="/menu/" class="text-xs text-brand-400 hover:underline font-semibold">
      Reset All
    </a>
  </div>

  <!-- Category Selection -->
  <div>
    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">Meal Category</h4>
    <div class="space-y-1.5">
      {categories.map((cat) => (
        <a
          href={`/menu/?category=${cat.id}`}
          class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
            currentCategory === cat.id
              ? 'bg-brand-600 text-white shadow-glow-green'
              : 'text-gray-300 hover:bg-dark-surface'
          }`}
        >
          <span class="flex items-center gap-2.5">
            <span class={`w-2.5 h-2.5 rounded-full ${cat.color}`}></span>
            {cat.name}
          </span>
        </a>
      ))}
    </div>
  </div>

  <!-- Macro Range Sliders -->
  <div class="space-y-4 pt-4 border-t border-dark-border">
    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400">Macro Targets</h4>
    
    <div>
      <div class="flex justify-between text-xs mb-1.5">
        <span class="text-gray-300 font-semibold">Min Protein</span>
        <span class="text-brand-400 font-bold" id="protein-val">40g+</span>
      </div>
      <input 
        type="range" 
        min="20" 
        max="75" 
        value="40" 
        class="w-full accent-brand-500 bg-dark-surface rounded-lg h-2" 
        id="protein-slider"
      />
    </div>

    <div>
      <div class="flex justify-between text-xs mb-1.5">
        <span class="text-gray-300 font-semibold">Max Calories</span>
        <span class="text-amber-400 font-bold" id="calories-val">600 cal</span>
      </div>
      <input 
        type="range" 
        min="200" 
        max="800" 
        step="25"
        value="600" 
        class="w-full accent-amber-500 bg-dark-surface rounded-lg h-2" 
        id="calories-slider"
      />
    </div>
  </div>

  <!-- Dietary Checkboxes -->
  <div class="pt-4 border-t border-dark-border">
    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">Dietary Preferences</h4>
    <div class="space-y-2">
      {dietaryOptions.map((opt) => (
        <label class="flex items-center gap-3 text-sm text-gray-300 cursor-pointer hover:text-white select-none">
          <input 
            type="checkbox" 
            name="dietary" 
            value={opt.id}
            class="w-4 h-4 rounded border-dark-border bg-dark-surface text-brand-600 focus:ring-brand-500" 
          />
          <span>{opt.label}</span>
        </label>
      ))}
    </div>
  </div>
</aside>
