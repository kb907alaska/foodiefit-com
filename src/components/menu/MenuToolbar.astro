---
export interface Props {
  totalCount: number;
  currentSort?: string;
  currentSearch?: string;
}

const { totalCount, currentSort = 'featured', currentSearch = '' } = Astro.props;
---

<div class="bg-dark-card border border-dark-border rounded-2xl p-4 flex flex-col md:flex-row items-center justify-between gap-4 mb-6">
  <!-- Search Input -->
  <form action="/menu/" method="GET" class="w-full md:w-80 relative">
    <div class="relative">
      <input
        type="search"
        name="search"
        placeholder="Search meals, steak, salmon..."
        value={currentSearch}
        class="w-full pl-10 pr-4 py-2.5 bg-dark-surface border border-dark-border rounded-xl text-sm text-white placeholder-gray-400 focus:outline-none focus:border-brand-500 transition-colors"
      />
      <svg class="w-4 h-4 text-gray-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </form>

  <!-- Summary Count & Mobile Filter Trigger -->
  <div class="flex items-center justify-between w-full md:w-auto gap-4">
    <span class="text-xs font-semibold text-gray-400">
      Showing <strong class="text-white font-bold">{totalCount}</strong> fresh meals
    </span>

    <!-- Mobile Drawer Trigger -->
    <button
      id="open-mobile-filters"
      type="button"
      class="lg:hidden inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-dark-surface border border-dark-border text-xs font-bold text-white hover:bg-dark-border"
    >
      <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
      </svg>
      Filters
    </button>

    <!-- Sort Dropdown -->
    <form action="/menu/" method="GET" class="flex items-center gap-2">
      <label for="sort-select" class="sr-only">Sort Meals</label>
      <select
        id="sort-select"
        name="sortBy"
        onchange="this.form.submit()"
        class="bg-dark-surface border border-dark-border rounded-xl px-3 py-2 text-xs font-semibold text-white focus:outline-none focus:border-brand-500"
      >
        <option value="featured" selected={currentSort === 'featured'}>Sort: Featured</option>
        <option value="protein-desc" selected={currentSort === 'protein-desc'}>Highest Protein</option>
        <option value="calories-asc" selected={currentSort === 'calories-asc'}>Lowest Calories</option>
        <option value="price-asc" selected={currentSort === 'price-asc'}>Price: Low to High</option>
        <option value="price-desc" selected={currentSort === 'price-desc'}>Price: High to Low</option>
        <option value="name-asc" selected={currentSort === 'name-asc'}>Name (A-Z)</option>
      </select>
    </form>
  </div>
</div>
