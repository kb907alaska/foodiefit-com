---
---

<form id="contact-form" action="#" method="POST" class="bg-dark-card border border-dark-border rounded-3xl p-8 space-y-6 shadow-2xl">
  <div id="contact-feedback" class="hidden p-4 rounded-xl text-sm font-semibold"></div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="c-name" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Full Name *</label>
      <input type="text" id="c-name" name="name" required class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500" placeholder="John Doe" />
    </div>

    <div>
      <label for="c-email" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Email Address *</label>
      <input type="email" id="c-email" name="email" required class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500" placeholder="john@example.com" />
    </div>
  </div>

  <div>
    <label for="c-subject" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Subject</label>
    <input type="text" id="c-subject" name="subject" class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500" placeholder="Question about order #1234" />
  </div>

  <div>
    <label for="c-message" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Message *</label>
    <textarea id="c-message" name="message" rows="5" required class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500" placeholder="How can our team help you?"></textarea>
  </div>

  <button type="submit" class="w-full py-4 rounded-xl font-display font-bold text-base text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow-green">
    Send Message
  </button>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('contact-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      feedback.classList.remove('hidden');
      feedback.classList.add('bg-brand-500/20', 'text-brand-300', 'border', 'border-brand-500/40');
      feedback.innerHTML = '<strong>Message Sent!</strong> Thank you for reaching out. A Foodie Fit support team member will respond within 4 business hours.';
      form.reset();
    });
  }
</script>
