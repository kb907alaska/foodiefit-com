---
import { COMMERCE_CONFIG } from '../../config/commerce';

const endpoint = COMMERCE_CONFIG.corporateFormEndpoint;
---

<form 
  id="corporate-inquiry-form"
  action={endpoint || "#"} 
  method="POST" 
  class="bg-dark-card border border-dark-border rounded-3xl p-8 sm:p-12 space-y-6 shadow-2xl"
>
  <div id="form-feedback" class="hidden p-4 rounded-xl text-sm font-semibold"></div>

  <!-- Honeypot Field -->
  <div class="hidden" aria-hidden="true">
    <label for="company_website_hp">Leave this blank</label>
    <input type="text" id="company_website_hp" name="company_website_hp" tabindex="-1" autocomplete="off" />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="first-name" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">First Name *</label>
      <input 
        type="text" 
        id="first-name" 
        name="firstName" 
        required 
        class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500"
        placeholder="Jane"
      />
    </div>

    <div>
      <label for="last-name" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Last Name *</label>
      <input 
        type="text" 
        id="last-name" 
        name="lastName" 
        required 
        class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500"
        placeholder="Smith"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="work-email" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Work Email *</label>
      <input 
        type="email" 
        id="work-email" 
        name="workEmail" 
        required 
        class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500"
        placeholder="jane@company.com"
      />
    </div>

    <div>
      <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Direct Phone *</label>
      <input 
        type="tel" 
        id="phone" 
        name="phone" 
        required 
        class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500"
        placeholder="(702) 555-0199"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="company-name" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Company Name *</label>
      <input 
        type="text" 
        id="company-name" 
        name="companyName" 
        required 
        class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500"
        placeholder="Vegas Tech Corp"
      />
    </div>

    <div>
      <label for="employee-count" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Total Employees *</label>
      <select 
        id="employee-count" 
        name="employeeCount" 
        required 
        class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-brand-500"
      >
        <option value="">Select Company Size</option>
        <option value="10-25">10 – 25 employees</option>
        <option value="26-50">26 – 50 employees</option>
        <option value="51-100">51 – 100 employees</option>
        <option value="100+">100+ employees</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="program-interest" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Program Interest</label>
      <select 
        id="program-interest" 
        name="programInterest" 
        class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-brand-500"
      >
        <option value="sponsored">Sponsored Company Meal Benefit</option>
        <option value="group">Employee-Paid Group Ordering</option>
        <option value="onetime">One-Time Event Catering Drop</option>
        <option value="tasting">Free Corporate Tasting Box</option>
      </select>
    </div>

    <div>
      <label for="zip-code" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Office ZIP Code *</label>
      <input 
        type="text" 
        id="zip-code" 
        name="zipCode" 
        required 
        pattern="[0-9]{5}"
        class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500"
        placeholder="89101"
      />
    </div>
  </div>

  <div>
    <label for="message" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2">Additional Notes / Dietary Preferences</label>
    <textarea 
      id="message" 
      name="message" 
      rows="4" 
      class="w-full bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500"
      placeholder="Tell us about your team's lunch schedule, delivery days, or dietary requirements..."
    ></textarea>
  </div>

  <div class="flex items-start gap-3">
    <input 
      type="checkbox" 
      id="consent" 
      name="consent" 
      required 
      class="w-4 h-4 mt-1 rounded border-dark-border bg-dark-surface text-brand-600 focus:ring-brand-500"
    />
    <label for="consent" class="text-xs text-gray-400">
      I agree to receive corporate program details and tasting confirmation via email and phone from Foodie Fit. View our <a href="/privacy/" class="text-brand-400 underline">Privacy Policy</a>.
    </label>
  </div>

  <!-- Cloudflare Turnstile Bot Protection Widget -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <div class="cf-turnstile my-4" data-sitekey="0x4AAAAAAAc1R2e3m4p5l6e7" data-theme="dark"></div>

  <button 
    type="submit"
    class="w-full py-4 rounded-xl font-display font-bold text-base text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow-green hover:scale-[1.01] transition-all text-center"
  >
    Submit Corporate Inquiry & Request Tasting
  </button>
</form>

<script>
  const form = document.getElementById('corporate-inquiry-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      const hp = (document.getElementById('company_website_hp') as HTMLInputElement)?.value;
      if (hp && hp.length > 0) {
        e.preventDefault();
        return;
      }

      // Check if endpoint configured
      const hasEndpoint = form.action && form.action.startsWith('http');
      if (!hasEndpoint) {
        e.preventDefault();
        feedback.classList.remove('hidden', 'bg-red-500/20', 'text-red-300', 'border-red-500/40');
        feedback.classList.add('bg-brand-500/20', 'text-brand-300', 'border', 'border-brand-500/40');
        feedback.innerHTML = '<strong>Demo Submission Received!</strong> Thank you for your corporate inquiry. Our B2B Catering Director will contact your team within 1 business day.';
        form.reset();
      }
    });
  }
</script>
