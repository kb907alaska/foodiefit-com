---
import { ExternalCommerceAdapter } from '../../lib/commerce/external-adapter';

const orderUrl = ExternalCommerceAdapter.getOrderUrl();
const accountUrl = ExternalCommerceAdapter.getAccountUrl();

const navLinks = [
  { name: 'Explore Menu', href: '/menu/' },
  { name: 'How It Works', href: '/how-it-works/' },
  { name: 'Delivery Information', href: '/delivery/' },
  { name: 'Subscriptions', href: '/subscriptions/' },
  { name: 'Store Locations', href: '/locations/' },
  { name: 'Corporate Meals', href: '/corporate-meals/' },
  { name: 'Custom Meal Prep', href: '/custom-meals/' },
  { name: 'By The Pound', href: '/by-the-pound/' },
  { name: 'Gift Cards', href: '/gift-cards/' },
  { name: 'Rewards & Referrals', href: '/rewards-referrals/' },
  { name: 'About Foodie Fit', href: '/about/' },
  { name: 'FAQ', href: '/faq/' },
  { name: 'Contact Us', href: '/contact/' },
];
---

<!-- Mobile Navigation Drawer Slideout -->
<div 
  id="mobile-drawer" 
  class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0 lg:hidden"
  aria-hidden="true"
>
  <!-- Backdrop -->
  <div id="mobile-drawer-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-sm transition-opacity"></div>

  <!-- Content Slideout -->
  <div class="absolute inset-y-0 right-0 w-full max-w-sm bg-dark-bg border-l border-dark-border shadow-2xl flex flex-col pointer-events-auto transform translate-x-full transition-transform duration-300 ease-out">
    <div class="p-6 border-b border-dark-border flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center font-display font-black text-white">FF</div>
        <span class="font-display text-xl uppercase font-bold text-white">FOODIE <span class="text-brand-500">FIT</span></span>
      </div>
      <button 
        id="close-drawer-btn"
        type="button" 
        class="p-2 rounded-lg text-gray-400 hover:text-white hover:bg-dark-surface focus:outline-none focus:ring-2 focus:ring-brand-500"
        aria-label="Close menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation List -->
    <div class="flex-1 overflow-y-auto px-6 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-3 rounded-xl text-base font-semibold text-gray-200 hover:text-white hover:bg-dark-surface transition-colors"
        >
          {link.name}
        </a>
      ))}
    </div>

    <!-- Drawer Footer Actions -->
    <div class="p-6 border-t border-dark-border bg-dark-surface space-y-3 pb-[calc(1.5rem+env(safe-area-inset-bottom))]">
      <a
        href={orderUrl}
        class="w-full inline-flex items-center justify-center py-3 px-6 rounded-xl font-display font-bold text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow-green text-center text-sm"
      >
        Start Online Order
      </a>
      <a
        href={accountUrl}
        class="w-full inline-flex items-center justify-center py-3 px-6 rounded-xl font-semibold text-gray-300 bg-dark-bg border border-dark-border hover:bg-dark-card text-center text-sm"
      >
        Customer Account Log In
      </a>
    </div>
  </div>
</div>

<!-- Persistent Mobile Sticky Bottom Bar -->
<div class="fixed bottom-0 inset-x-0 z-30 lg:hidden bg-dark-bg/95 backdrop-blur-md border-t border-dark-border p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] shadow-2xl">
  <div class="grid grid-cols-2 gap-3 max-w-md mx-auto">
    <a
      href="/menu/"
      class="inline-flex items-center justify-center py-3 px-4 rounded-xl font-display text-sm font-bold text-white bg-dark-card border border-dark-border hover:border-brand-500 transition-colors text-center"
    >
      <svg class="w-4 h-4 mr-2 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      Browse Menu
    </a>
    <a
      href={orderUrl}
      class="inline-flex items-center justify-center py-3 px-4 rounded-xl font-display text-sm font-bold text-white bg-gradient-to-r from-brand-600 to-brand-500 shadow-glow-green text-center"
    >
      Order Now
    </a>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('close-drawer-btn');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('mobile-drawer-backdrop');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function openDrawer() {
    if (!drawer) return;
    drawer.classList.remove('pointer-events-none', 'opacity-0');
    drawer.classList.add('opacity-100');
    const content = drawer.querySelector('.transform');
    if (content) {
      content.classList.remove('translate-x-full');
      content.classList.add('translate-x-0');
    }
    toggleBtn?.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    hamburgerIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!drawer) return;
    const content = drawer.querySelector('.transform');
    if (content) {
      content.classList.remove('translate-x-0');
      content.classList.add('translate-x-full');
    }
    drawer.classList.remove('opacity-100');
    drawer.classList.add('opacity-0', 'pointer-events-none');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', () => {
    const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeDrawer(); else openDrawer();
  });

  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });
</script>
