---
import { ExternalCommerceAdapter } from '../../lib/commerce/external-adapter';
import MegaMenu from './MegaMenu.astro';

const orderUrl = ExternalCommerceAdapter.getOrderUrl();
const accountUrl = ExternalCommerceAdapter.getAccountUrl();

const pathname = Astro.url.pathname;

const navLinks = [
  { name: 'Menu', href: '/menu/', isMega: true },
  { name: 'How It Works', href: '/how-it-works/' },
  { name: 'Locations', href: '/locations/' },
  { name: 'Corporate Meals', href: '/corporate-meals/' },
  { name: 'About', href: '/about/' },
  { name: 'FAQ', href: '/faq/' },
];
---

<header class="sticky top-0 z-40 bg-white/95 dark:bg-dark-bg/95 backdrop-blur-md border-b border-gray-200 dark:border-dark-border transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between relative">
    <!-- Clean Real Logo Image Only -->
    <a href="/" class="flex items-center group focus:outline-none focus:ring-2 focus:ring-brand-500 rounded-lg p-1" aria-label="Foodie Fit Homepage">
      <img src="/images/foodiefit-logo.png" alt="Foodie Fit Logo" class="brand-logo-img h-10 sm:h-12 w-auto object-contain transition-transform group-hover:scale-105" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Main Navigation">
      {navLinks.map((link) => {
        const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
        if (link.isMega) {
          return (
            <div class="relative py-6">
              <a
                id="nav-mega-trigger"
                href={link.href}
                class={`text-sm font-semibold transition-colors hover:text-brand-500 py-2 border-b-2 inline-flex items-center gap-1.5 ${
                  isActive ? 'text-brand-500 border-brand-500' : 'text-slate-700 dark:text-gray-300 border-transparent'
                }`}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="mega-menu-panel"
              >
                <span>{link.name}</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-brand-500 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
            </div>
          );
        }
        return (
          <a
            href={link.href}
            class={`text-sm font-semibold transition-colors hover:text-brand-500 py-2 border-b-2 ${
              isActive ? 'text-brand-500 border-brand-500' : 'text-slate-700 dark:text-gray-300 border-transparent'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Desktop Actions -->
    <div class="hidden lg:flex items-center gap-4">
      <!-- Dark / Light Theme Toggle Button -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="p-2.5 rounded-xl text-slate-600 dark:text-gray-300 hover:text-brand-500 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-dark-surface focus:outline-none focus:ring-2 focus:ring-brand-500 transition-colors cursor-pointer"
        aria-label="Toggle dark/light mode"
        title="Toggle Light/Dark Theme"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-sun-icon" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-moon-icon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <a
        href={accountUrl}
        class="text-sm font-semibold text-slate-700 dark:text-gray-300 hover:text-slate-900 dark:hover:text-white px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-dark-surface transition-colors"
      >
        Account
      </a>
      <a
        href={orderUrl}
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-xl font-display text-sm font-bold text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow-red hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all"
      >
        Order Now
      </a>
    </div>

    <!-- Mobile Controls -->
    <div class="flex lg:hidden items-center gap-2">
      <!-- Mobile Theme Toggle -->
      <button
        id="theme-toggle-btn-mobile"
        type="button"
        class="p-2 rounded-lg text-slate-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-surface"
        aria-label="Toggle dark/light mode"
      >
        <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <a
        href={orderUrl}
        class="inline-flex items-center justify-center px-4 py-2 rounded-lg font-display text-xs font-bold text-white bg-brand-600 hover:bg-brand-500 transition-colors"
      >
        Order Now
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="p-2.5 rounded-lg text-slate-700 dark:text-gray-300 hover:text-slate-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-dark-surface focus:outline-none focus:ring-2 focus:ring-brand-500"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Page-Width Mega Menu Dropdown -->
    <MegaMenu />

  </div>
</header>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle-btn');
    const btnMobile = document.getElementById('theme-toggle-btn-mobile');

    const toggleTheme = () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('foodiefit_theme', isDark ? 'dark' : 'light');
    };

    if (btn) {
      btn.removeEventListener('click', toggleTheme);
      btn.addEventListener('click', toggleTheme);
    }
    if (btnMobile) {
      btnMobile.removeEventListener('click', toggleTheme);
      btnMobile.addEventListener('click', toggleTheme);
    }
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
