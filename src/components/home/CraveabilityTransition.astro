---
---

<section class="py-20 bg-dark-surface border-b border-dark-border relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-3 block">
      Chef-Crafted Excellence
    </span>
    <h2 class="clamp-h2 font-display font-black text-white uppercase tracking-tight mb-6">
      This Is What Healthy <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-brand-500">
        Should Taste Like.
      </span>
    </h2>
    <p class="text-gray-300 max-w-2xl mx-auto text-base sm:text-lg mb-12">
      No bland rubbery chicken. No unseasoned steamed broccoli. Every recipe is created by culinary trained chefs using real herbs, natural spices, and premium proteins.
    </p>

    <!-- Editorial 3-Photo Collage -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
      <div class="relative rounded-2xl overflow-hidden border border-dark-border group aspect-[4/3]">
        <img 
          src="/images/meals/impossible-dumplings.jpg" 
          alt="Teriyaki Chicken and Jasmine Rice" 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-dark-bg via-transparent to-transparent opacity-90"></div>
        <div class="absolute bottom-4 left-4 right-4 text-white">
          <span class="text-xs uppercase font-bold text-emerald-400 tracking-wider">Active Category</span>
          <h3 class="font-display font-bold text-lg">Teriyaki Chicken Power Plate</h3>
          <p class="text-xs text-gray-300">48g Protein • 58g Carbs • 520 Cal</p>
        </div>
      </div>

      <div class="relative rounded-2xl overflow-hidden border border-dark-border group aspect-[4/3]">
        <img 
          src="/images/meals/backyard-bbq-plate.jpg" 
          alt="Cinnamon Roll Protein Pancakes" 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-dark-bg via-transparent to-transparent opacity-90"></div>
        <div class="absolute bottom-4 left-4 right-4 text-white">
          <span class="text-xs uppercase font-bold text-amber-400 tracking-wider">Breakfast Category</span>
          <h3 class="font-display font-bold text-lg">Cinnamon Roll Pancakes</h3>
          <p class="text-xs text-gray-300">40g Protein • 52g Carbs • 460 Cal</p>
        </div>
      </div>

      <div class="relative rounded-2xl overflow-hidden border border-dark-border group aspect-[4/3]">
        <img 
          src="/images/meals/rancheros-breakfast-burrito.jpg" 
          alt="Fudge Brownie Protein Bites" 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-dark-bg via-transparent to-transparent opacity-90"></div>
        <div class="absolute bottom-4 left-4 right-4 text-white">
          <span class="text-xs uppercase font-bold text-blue-400 tracking-wider">Snack & Dessert</span>
          <h3 class="font-display font-bold text-lg">Fudge Brownie Bites</h3>
          <p class="text-xs text-gray-300">20g Protein • 22g Carbs • 260 Cal</p>
        </div>
      </div>
    </div>
  </div>
</section>
