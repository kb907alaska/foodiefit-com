---
import { COMMERCE_CONFIG } from '../../config/commerce';
import LocationCard from '../locations/LocationCard.astro';
---

<section class="py-20 bg-dark-surface border-b border-dark-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-2 block">
          Retail & Pickup Storefronts
        </span>
        <h2 class="clamp-h2 font-display font-black text-white uppercase tracking-tight">
          3 Las Vegas Store Locations
        </h2>
      </div>
      <a
        href="/locations/"
        class="mt-4 md:mt-0 font-display text-sm font-bold text-brand-400 hover:text-brand-300 inline-flex items-center gap-2"
      >
        View Store Details & Directions &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {COMMERCE_CONFIG.storeLocations.map((store) => (
        <LocationCard location={store} />
      ))}
    </div>
  </div>
</section>
