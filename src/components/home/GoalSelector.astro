---
const goals = [
  {
    title: 'High Protein',
    subtitle: '45g+ Protein Per Portion',
    category: 'active',
    tag: 'high-protein',
    image: '/images/meals/impossible-dumplings.jpg',
    color: 'from-brand-600/80 to-dark-bg'
  },
  {
    title: 'Low Carb',
    subtitle: 'Under 15g Net Carbs',
    category: 'low-carb',
    tag: 'low-carb',
    image: '/images/meals/backyard-bbq-plate.jpg',
    color: 'from-red-600/80 to-dark-bg'
  },
  {
    title: 'Balanced / Active',
    subtitle: 'Optimal Carb & Protein Fuel',
    category: 'active',
    tag: 'all',
    image: '/images/meals/rancheros-breakfast-burrito.jpg',
    color: 'from-brand-600/80 to-dark-bg'
  },
  {
    title: 'Chef Breakfasts',
    subtitle: 'Pancakes, Scrambles & Burritos',
    category: 'breakfast',
    tag: 'all',
    image: '/images/meals/chicken-tendies-mac.jpg',
    color: 'from-amber-600/80 to-dark-bg'
  },
  {
    title: 'Snacks & Desserts',
    subtitle: 'Protein Bites, Cookies & Shakes',
    category: 'snack-dessert',
    tag: 'all',
    image: '/images/meals/nashville-hot-chicken.jpg',
    color: 'from-blue-600/80 to-dark-bg'
  },
  {
    title: 'Custom Meal Prep',
    subtitle: 'Build Your Own Ounces',
    href: '/custom-meals/',
    image: '/images/meals/southwest-salad.jpg',
    color: 'from-purple-600/80 to-dark-bg'
  }
];
---

<section class="py-20 bg-dark-bg border-b border-dark-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-2 block">
          Targeted Nutrition
        </span>
        <h2 class="clamp-h2 font-display font-black text-white uppercase tracking-tight">
          Shop By Goal
        </h2>
      </div>
      <p class="text-gray-400 text-sm max-w-md mt-2 md:mt-0">
        Filter instantly by your specific macros, body composition target, or daily schedule.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {goals.map((g) => (
        <a
          href={g.href || `/menu/?category=${g.category}`}
          class="relative rounded-2xl overflow-hidden border border-dark-border bg-dark-card group card-hover-effect h-56 flex flex-col justify-end p-6"
        >
          <img 
            src={g.image} 
            alt={g.title} 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div class={`absolute inset-0 bg-gradient-to-t ${g.color} opacity-90`}></div>
          
          <div class="relative z-10">
            <h3 class="font-display font-black text-xl text-white uppercase tracking-wide mb-1">
              {g.title}
            </h3>
            <p class="text-xs text-gray-200 font-medium">
              {g.subtitle} &rarr;
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
