---

<section class="py-20 bg-dark-bg border-b border-dark-border relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-r from-brand-900/40 via-dark-card to-dark-card border border-brand-500/30 rounded-3xl p-8 sm:p-14 relative overflow-hidden shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8 space-y-6">
          <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-brand-500/20 text-brand-400 border border-brand-500/40 uppercase tracking-wider inline-block">
            Corporate & Group Catering
          </span>

          <h2 class="clamp-h2 font-display font-black text-white uppercase tracking-tight">
            Office Lunch Your Team <br />
            <span class="text-brand-400">Looks Forward To.</span>
          </h2>

          <p class="text-gray-300 text-base sm:text-lg max-w-2xl leading-relaxed">
            Ditch unhealthy fast food platters. Feed your Las Vegas team chef-crafted, high-protein meals with individual macro labeling and dietary accommodations.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-dark-bg/80 border border-dark-border">
              <h4 class="font-bold text-white text-sm mb-1">Sponsored Meals</h4>
              <p class="text-xs text-gray-400">Company subsidized weekly health meal benefit.</p>
            </div>
            <div class="p-4 rounded-xl bg-dark-bg/80 border border-dark-border">
              <h4 class="font-bold text-white text-sm mb-1">Group Ordering</h4>
              <p class="text-xs text-gray-400">Employee-paid orders delivered together.</p>
            </div>
            <div class="p-4 rounded-xl bg-dark-bg/80 border border-dark-border">
              <h4 class="font-bold text-white text-sm mb-1">One-Time Drops</h4>
              <p class="text-xs text-gray-400">Special event or meeting lunch drops.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 flex flex-col items-center lg:items-end justify-center">
          <a
            href="/corporate-meals/"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow-green hover:scale-105 transition-all text-center"
          >
            Request Free Tasting &rarr;
          </a>
          <span class="text-xs text-dark-muted mt-3">Free sample drop for qualifying teams of 15+</span>
        </div>

      </div>
    </div>
  </div>
</section>
