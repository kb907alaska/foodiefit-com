---
---

<section class="relative bg-dark-bg overflow-hidden py-16 lg:py-28 border-b border-dark-border">
  <!-- Background Glow & Grid Overlay -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-brand-600/20 via-transparent to-transparent pointer-events-none"></div>
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f293710_1px,transparent_1px),linear-gradient(to_bottom,#1f293710_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Hero Column -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        <!-- Top Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-400 text-xs font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-brand-500 animate-ping"></span>
          Las Vegas Fresh Prepared Meals
        </div>

        <!-- Headline -->
        <h1 class="clamp-hero font-display font-black text-white uppercase tracking-tight">
          Healthy Never <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-brand-500 to-rose-300">
            Tasted This Good.
          </span>
        </h1>

        <!-- Subheadline / Supporting Promise -->
        <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Chef-crafted meals made fresh daily in Las Vegas. Delivered as early as tomorrow or ready at one of three local stores.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="/menu/"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow-green hover:shadow-2xl hover:scale-105 transition-all text-center"
          >
            Shop Meals
          </a>
          <a
            href="/how-it-works/"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl font-display font-bold text-base text-gray-200 bg-dark-card border border-dark-border hover:border-brand-500/50 hover:bg-dark-surface transition-all text-center"
          >
            How It Works
          </a>
        </div>

        <!-- Proof Row Grid -->
        <div class="pt-8 border-t border-dark-border/60 grid grid-cols-2 sm:grid-cols-4 gap-4 text-left">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 font-bold text-xs flex-shrink-0">
              ✓
            </div>
            <span class="text-xs font-semibold text-gray-300 leading-tight">Fresh, Never Frozen</span>
          </div>

          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 font-bold text-xs flex-shrink-0">
              30+
            </div>
            <span class="text-xs font-semibold text-gray-300 leading-tight">Rotating Options</span>
          </div>

          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 font-bold text-xs flex-shrink-0">
              $0
            </div>
            <span class="text-xs font-semibold text-gray-300 leading-tight">No Order Minimum</span>
          </div>

          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 font-bold text-xs flex-shrink-0">
              3
            </div>
            <span class="text-xs font-semibold text-gray-300 leading-tight">Vegas Stores or Delivery</span>
          </div>
        </div>
      </div>

      <!-- Right Hero Composition Image -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Main Hero Image Box -->
          <div class="rounded-3xl overflow-hidden border border-dark-border bg-dark-card shadow-2xl relative group">
            <img 
              src="/images/meals/korean-steak.jpg" 
              alt="Foodie Fit Grilled Steak and Asparagus Meal Prep"
              class="w-full h-[420px] sm:h-[480px] object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-dark-bg via-transparent to-transparent opacity-80"></div>
            
            <!-- Hero Floating Macro Badge -->
            <div class="absolute bottom-6 left-6 right-6 glass-panel rounded-2xl p-4 border border-white/10 text-white">
              <div class="flex items-center justify-between mb-2">
                <span class="font-display font-bold text-sm tracking-wide">Grilled Sirloin Steak</span>
                <span class="text-xs px-2.5 py-0.5 rounded bg-red-500/20 text-red-400 border border-red-500/40 font-bold">Low-Carb</span>
              </div>
              <div class="grid grid-cols-4 text-center text-xs pt-2 border-t border-white/10">
                <div><span class="text-[10px] text-gray-400 block">CAL</span><span class="font-bold">410</span></div>
                <div><span class="text-[10px] text-brand-400 block">PRO</span><span class="font-bold text-brand-400">48g</span></div>
                <div><span class="text-[10px] text-amber-400 block">CARB</span><span class="font-bold text-amber-400">8g</span></div>
                <div><span class="text-[10px] text-gray-400 block">FAT</span><span class="font-bold">20g</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
