---
import '../styles/global.css';
import '../styles/accessibility.css';
import OrderStartBar from '../components/commerce/OrderStartBar.astro';
import AnnouncementBar from '../components/global/AnnouncementBar.astro';
import Header from '../components/global/Header.astro';
import MobileNav from '../components/global/MobileNav.astro';
import Footer from '../components/global/Footer.astro';
import AccessibilityPanel from '../components/global/AccessibilityPanel.astro';
import MacroComparisonDrawer from '../components/menu/MacroComparisonDrawer.astro';
import SEO from '../components/seo/SEO.astro';
import StructuredData from '../components/seo/StructuredData.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, image, canonical, noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <SEO title={title} description={description} image={image} canonical={canonical} noindex={noindex} />
    <StructuredData type="Organization" />
    <script is:inline>
      // Restore Theme
      const savedTheme = localStorage.getItem('foodiefit_theme');
      if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      // Restore WCAG 2.2 Accessibility Settings early before render
      try {
        const savedA11y = localStorage.getItem('siteAccessibilitySettings');
        if (savedA11y) {
          const settings = JSON.parse(savedA11y);
          if (Array.isArray(settings)) {
            settings.forEach(s => document.documentElement.classList.add(s));
          }
        }
      } catch (e) {}
    </script>
  </head>
  <body class="bg-white dark:bg-dark-bg text-slate-900 dark:text-gray-100 antialiased selection:bg-brand-500 selection:text-white flex flex-col min-h-screen transition-colors">
    <!-- Skip to main content for WCAG accessibility -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 bg-brand-600 text-white font-bold px-4 py-2 rounded-lg shadow-lg"
    >
      Skip to main content
    </a>

    <OrderStartBar />
    <AnnouncementBar />
    <Header />

    <main id="main-content" class="flex-1 pb-16 lg:pb-0">
      <slot />
    </main>

    <Footer />
    <MobileNav />
    <AccessibilityPanel />
    <MacroComparisonDrawer />
  </body>
</html>
