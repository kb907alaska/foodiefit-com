---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  publishDate?: string;
  author?: string;
  image?: string;
  category?: string;
  readTime?: string;
}

const { title, description, publishDate, author, image, category, readTime } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={[
      { name: 'Blog', href: '/blog/' },
      { name: title }
    ]} />

    <header class="mb-10 text-center sm:text-left">
      {category && (
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-500/10 text-brand-400 border border-brand-500/30 mb-4">
          {category}
        </span>
      )}
      <h1 class="font-display text-3xl sm:text-5xl font-black text-white leading-tight mb-4">
        {title}
      </h1>
      <p class="text-xl text-gray-300 mb-6 leading-relaxed">
        {description}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-dark-border text-sm text-gray-400">
        <div class="flex items-center gap-3">
          {author && (
            <span class="font-semibold text-white">By {author}</span>
          )}
          {publishDate && (
            <>
              <span>•</span>
              <time datetime={publishDate}>{publishDate}</time>
            </>
          )}
        </div>
        {readTime && (
          <span class="text-brand-400 font-medium">{readTime}</span>
        )}
      </div>
    </header>

    {image && (
      <div class="mb-12 rounded-2xl overflow-hidden shadow-2xl border border-dark-border">
        <img src={image} alt={title} class="w-full max-h-[450px] object-cover" />
      </div>
    )}

    <article class="prose prose-invert prose-emerald max-w-none prose-headings:font-display prose-headings:text-white prose-p:text-gray-300 prose-p:leading-relaxed prose-li:text-gray-300 prose-strong:text-white">
      <slot />
    </article>
  </div>
</BaseLayout>
