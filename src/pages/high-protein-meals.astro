---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import MealGrid from '../components/menu/MealGrid.astro';
import DirectAnswer from '../components/seo/DirectAnswer.astro';
import { MEALS_DATA } from '../data/meals';
import { ExternalCommerceAdapter } from '../lib/commerce/external-adapter';

const orderUrl = ExternalCommerceAdapter.getOrderUrl();
const highProteinMeals = MEALS_DATA.filter(m => m.protein >= 40).sort((a, b) => b.protein - a.protein);
---

<BaseLayout
  title="High Protein Meals Las Vegas (45g+ Protein) | Foodie Fit"
  description="Explore high-protein prepared meals made fresh daily in Las Vegas. 45g–70g+ protein per serving, cooked fresh with lean steak, chicken, turkey, and salmon."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'High Protein Meals' }]} />

    <div class="text-center max-w-3xl mx-auto my-12">
      <span class="text-brand-600 dark:text-brand-400 font-bold uppercase tracking-widest text-xs mb-2 block">
        45g – 70g+ Protein Per Portion
      </span>
      <h1 class="font-display font-black text-4xl sm:text-6xl text-slate-900 dark:text-white uppercase tracking-tight mb-6">
        High Protein Meal Prep
      </h1>
      <p class="text-slate-600 dark:text-gray-300 text-lg leading-relaxed">
        Engineered for muscle recovery, strength training, and lean body composition goals. Cooked fresh daily in Las Vegas.
      </p>
    </div>

    <DirectAnswer 
      question="What qualifies as a Foodie Fit High Protein meal?"
      answer="Every meal in our High-Protein collection contains at least 40g to 70g+ of bioavailable protein per serving. Portion sizes can be upgraded from standard Lean to Bulk (+50% extra protein) for intense training demands."
    />

    <!-- Products Grid -->
    <div class="my-12">
      <MealGrid meals={highProteinMeals.slice(0, 12)} />
    </div>

    <div class="text-center py-8">
      <a href={orderUrl} class="inline-flex items-center justify-center px-8 py-4 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow-red hover:scale-105 transition-all">
        Order High-Protein Meals &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
