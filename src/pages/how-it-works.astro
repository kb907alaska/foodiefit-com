---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { ExternalCommerceAdapter } from '../lib/commerce/external-adapter';

const orderUrl = ExternalCommerceAdapter.getOrderUrl();
---

<BaseLayout
  title="How It Works | Foodie Fit Las Vegas Meal Prep"
  description="Learn how Foodie Fit makes healthy eating easy. Pick your date, select meals & portions, choose delivery or store pickup."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'How It Works' }]} />

    <div class="text-center max-w-3xl mx-auto my-12">
      <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-2 block">
        Frictionless Healthy Eating
      </span>
      <h1 class="font-display font-black text-4xl sm:text-6xl text-slate-900 dark:text-white uppercase tracking-tight mb-6">
        How Foodie Fit Works
      </h1>
      <p class="text-slate-600 dark:text-gray-300 text-lg leading-relaxed">
        Fresh chef-cooked meals designed for your lifestyle. Whether you need next-day home delivery or a 60-second store pickup in Las Vegas, we have you covered.
      </p>
    </div>

    <!-- 3 Fulfillment Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 my-16">
      <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-3xl p-8 space-y-4 shadow-sm">
        <div class="w-12 h-12 rounded-2xl bg-brand-500/10 border border-brand-500/30 flex items-center justify-center text-brand-500 font-bold text-xl">
          1
        </div>
        <h3 class="font-display font-bold text-xl text-slate-900 dark:text-white uppercase">Local Las Vegas Delivery</h3>
        <p class="text-sm text-slate-600 dark:text-gray-300 leading-relaxed">
          Order by 6:00 PM for next-day delivery to your home or office. Delivered in insulated cold bags with ice packs that stay refrigerated for up to 6 hours.
        </p>
      </div>

      <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-3xl p-8 space-y-4 shadow-sm">
        <div class="w-12 h-12 rounded-2xl bg-brand-500/10 border border-brand-500/30 flex items-center justify-center text-brand-500 font-bold text-xl">
          2
        </div>
        <h3 class="font-display font-bold text-xl text-slate-900 dark:text-white uppercase">In-Store Pre-Order Pickup</h3>
        <p class="text-sm text-slate-600 dark:text-gray-300 leading-relaxed">
          Select Green Valley, Summerlin, or Northwest during checkout. Your order will be bagged and waiting on our express pickup shelf.
        </p>
      </div>

      <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-3xl p-8 space-y-4 shadow-sm">
        <div class="w-12 h-12 rounded-2xl bg-brand-500/10 border border-brand-500/30 flex items-center justify-center text-brand-500 font-bold text-xl">
          3
        </div>
        <h3 class="font-display font-bold text-xl text-slate-900 dark:text-white uppercase">Walk-In Grab & Go</h3>
        <p class="text-sm text-slate-600 dark:text-gray-300 leading-relaxed">
          No order placed? No problem. Visit any store 8:00 AM – 8:00 PM daily to browse our refrigerators stocked fresh every morning.
        </p>
      </div>
    </div>

    <div class="text-center py-8">
      <a
        href={orderUrl}
        class="inline-flex items-center justify-center px-8 py-4 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-brand-600 to-brand-500 shadow-glow-red hover:scale-105 transition-all"
      >
        Start Your Order Now &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
