---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import MealGrid from '../components/menu/MealGrid.astro';
import DirectAnswer from '../components/seo/DirectAnswer.astro';
import { MEALS_DATA } from '../data/meals';
import { ExternalCommerceAdapter } from '../lib/commerce/external-adapter';

const orderUrl = ExternalCommerceAdapter.getOrderUrl();
const newMeals = MEALS_DATA.filter(m => m.isNew || m.featured).slice(0, 12);
const currentDate = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<BaseLayout
  title="New Meals This Week | Foodie Fit Las Vegas Rotation"
  description="Explore the latest chef specials, returning favorites, and seasonal menu items available this week at Foodie Fit Las Vegas."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'New This Week' }]} />

    <div class="text-center max-w-3xl mx-auto my-12">
      <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-2 block">
        Current Menu Rotation • Updated {currentDate}
      </span>
      <h1 class="font-display font-black text-4xl sm:text-6xl text-white uppercase tracking-tight mb-6">
        New This Week
      </h1>
      <p class="text-gray-300 text-lg leading-relaxed">
        Fresh seasonal recipes and returning customer favorites cooked fresh in our Southern Nevada kitchen.
      </p>
    </div>

    <DirectAnswer 
      question="How often does Foodie Fit rotate new meal items?"
      answer="Foodie Fit introduces new chef specials and seasonal recipes every few weeks while maintaining core high-protein customer favorites across all 3 Las Vegas locations."
    />

    <div class="my-12">
      <MealGrid meals={newMeals} />
    </div>

    <div class="text-center py-8">
      <a href={orderUrl} class="px-8 py-4 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-brand-600 to-brand-500 shadow-glow-green hover:scale-105 transition-all">
        Order This Week's Menu &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
