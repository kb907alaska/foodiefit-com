---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MEALS_DATA } from '../../data/meals';
import CategoryBadge from '../../components/menu/CategoryBadge.astro';
import DietaryBadge from '../../components/menu/DietaryBadge.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { ExternalCommerceAdapter } from '../../lib/commerce/external-adapter';

export function getStaticPaths() {
  return MEALS_DATA.map((meal) => ({
    params: { slug: meal.slug },
    props: { meal }
  }));
}

const { meal } = Astro.props;
const orderUrl = ExternalCommerceAdapter.getOrderUrl(meal.sku);
---

<BaseLayout
  title={`${meal.name} | Foodie Fit Nutrition & Ordering`}
  description={`${meal.description} ${meal.protein}g Protein, ${meal.calories} Calories. Made fresh daily in Las Vegas.`}
  image={meal.image}
>
  <StructuredData type="Product" data={meal} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[
      { name: 'Menu', href: '/menu/' },
      { name: meal.name }
    ]} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 my-8">
      
      <!-- Left Column: Meal Image & Quick Specs -->
      <div class="lg:col-span-6 space-y-6">
        <div class="relative rounded-3xl overflow-hidden border border-dark-border bg-dark-card aspect-[4/3] shadow-2xl">
          <img src={meal.image} alt={meal.name} class="w-full h-full object-cover" />
          <div class="absolute top-4 left-4">
            <CategoryBadge category={meal.category} />
          </div>
        </div>

        <!-- Heating & Storage Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-dark-card border border-dark-border">
            <h4 class="font-display font-bold text-sm text-white uppercase mb-2 flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Heating Directions
            </h4>
            <p class="text-xs text-gray-300 leading-relaxed">{meal.heatingInstructions}</p>
          </div>

          <div class="p-5 rounded-2xl bg-dark-card border border-dark-border">
            <h4 class="font-display font-bold text-sm text-white uppercase mb-2 flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8" />
              </svg>
              Storage Guidance
            </h4>
            <p class="text-xs text-gray-300 leading-relaxed">{meal.storageInstructions}</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Nutrition Label & Actions -->
      <div class="lg:col-span-6 space-y-8">
        <div>
          <div class="flex items-center justify-between gap-4 mb-2">
            <span class="text-xs font-mono text-dark-muted">SKU: {meal.sku}</span>
            <div class="flex gap-1.5">
              {meal.dietaryTags.map(t => <DietaryBadge tag={t} />)}
            </div>
          </div>

          <h1 class="font-display font-black text-3xl sm:text-4xl text-white uppercase tracking-tight mb-4">
            {meal.name}
          </h1>

          <p class="text-gray-300 text-base leading-relaxed mb-6">
            {meal.longDescription}
          </p>

          <!-- Portion Options Selector -->
          {meal.portionOptions && meal.portionOptions.length > 0 && (
            <div class="p-4 rounded-2xl bg-dark-card border border-dark-border mb-6">
              <span class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">Select Portion Size</span>
              <div class="grid grid-cols-2 gap-3">
                {meal.portionOptions.map((p) => (
                  <div class="p-3 rounded-xl border border-brand-500/50 bg-brand-500/10 text-white flex flex-col justify-between">
                    <div>
                      <span class="font-bold text-sm block">{p.name}</span>
                      <span class="text-xs text-brand-400 font-semibold">{p.protein}g Protein • {p.calories} Cal</span>
                    </div>
                    <span class="font-display text-lg font-bold mt-2">${p.price.toFixed(2)}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Nutrition Label Box -->
          <div class="nutrition-label bg-white text-black p-6 rounded-2xl shadow-xl max-w-sm mb-6">
            <h2 class="font-black text-2xl uppercase border-b-8 border-black pb-1 leading-none">Nutrition Facts</h2>
            <div class="text-xs font-bold py-1 border-b-4 border-black flex justify-between">
              <span>Serving Size</span>
              <span>1 Container</span>
            </div>
            
            <div class="py-2 border-b-4 border-black flex items-end justify-between">
              <div>
                <span class="text-xs font-bold block">Amount Per Serving</span>
                <span class="text-2xl font-black leading-none">Calories</span>
              </div>
              <span class="text-4xl font-black leading-none">{meal.calories}</span>
            </div>

            <div class="text-xs divide-y divide-gray-300 border-b-4 border-black">
              <div class="py-1 flex justify-between font-bold text-brand-600">
                <span>Protein</span>
                <span>{meal.protein}g</span>
              </div>
              <div class="py-1 flex justify-between font-bold text-amber-700">
                <span>Total Carbohydrates</span>
                <span>{meal.carbs}g</span>
              </div>
              {meal.fiber && (
                <div class="py-1 pl-4 flex justify-between text-gray-600">
                  <span>Dietary Fiber</span>
                  <span>{meal.fiber}g</span>
                </div>
              )}
              <div class="py-1 flex justify-between font-semibold">
                <span>Total Fat</span>
                <span>{meal.fat}g</span>
              </div>
              {meal.sodium && (
                <div class="py-1 flex justify-between text-gray-600">
                  <span>Sodium</span>
                  <span>{meal.sodium}mg</span>
                </div>
              )}
            </div>

            <p class="text-[10px] text-gray-500 pt-2 leading-tight">
              * Percent Daily Values are based on a 2,000 calorie diet.
            </p>
          </div>

          <!-- Ingredients & Allergens -->
          <div class="space-y-4 p-5 rounded-2xl bg-dark-card border border-dark-border text-xs">
            <div>
              <span class="font-bold text-white uppercase block mb-1">Ingredients:</span>
              <p class="text-gray-300 leading-relaxed">{meal.ingredients.join(', ')}.</p>
            </div>
            {meal.allergens.length > 0 ? (
              <div class="text-red-400 font-semibold">
                <span>Contains Allergens: </span>
                <span>{meal.allergens.join(', ')}.</span>
              </div>
            ) : (
              <div class="text-brand-400 font-semibold">
                <span>No Major Common Allergens in Recipe Ingredients.</span>
              </div>
            )}
            <p class="text-[11px] text-dark-muted pt-2 border-t border-dark-border">
              Prepared in a shared commercial facility. Review our full <a href="/nutrition-allergen-disclaimer/" class="underline text-brand-400">Nutrition & Allergen Disclaimer</a>.
            </p>
          </div>

          <!-- Action CTA -->
          <div class="pt-6 flex flex-col sm:flex-row items-center gap-4">
            <a
              href={orderUrl}
              class="w-full sm:flex-1 py-4 px-8 rounded-2xl font-display text-base font-bold text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow-green text-center transition-all"
            >
              Order This Meal Now &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
