---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import DirectAnswer from '../../components/seo/DirectAnswer.astro';
import { ExternalCommerceAdapter } from '../../lib/commerce/external-adapter';

const orderUrl = ExternalCommerceAdapter.getOrderUrl();

const areas = [
  { name: 'Las Vegas (City-Wide)', href: '/delivery/las-vegas/', zips: '89101, 89102, 89103, 89104, 89107, 89108, 89117...' },
  { name: 'Henderson & Green Valley', href: '/delivery/henderson/', zips: '89011, 89012, 89014, 89044, 89052, 89074, 89123...' },
  { name: 'Summerlin & West Vegas', href: '/delivery/summerlin/', zips: '89135, 89138, 89144, 89145, 89147, 89148...' },
  { name: 'Spring Valley & The Lakes', href: '/delivery/spring-valley/', zips: '89103, 89117, 89146, 89147...' },
  { name: 'Enterprise & Southwest', href: '/delivery/enterprise/', zips: '89139, 89141, 89178, 89179...' },
  { name: 'Paradise & Strip Corridor', href: '/delivery/paradise/', zips: '89109, 89119, 89120, 89121, 89169...' },
  { name: 'Centennial Hills & Northwest', href: '/delivery/centennial-hills/', zips: '89129, 89130, 89131, 89143, 89149, 89166...' },
  { name: 'North Las Vegas', href: '/delivery/north-las-vegas/', zips: '89030, 89031, 89032, 89081, 89084, 89085...' }
];
---

<BaseLayout
  title="Las Vegas & Henderson Delivery Areas Hub | Foodie Fit"
  description="Check your ZIP code for fresh meal delivery in Las Vegas, Henderson, Summerlin, Enterprise, Spring Valley, Paradise, and Centennial Hills."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Delivery Areas' }]} />

    <div class="text-center max-w-3xl mx-auto my-12">
      <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-2 block">
        Local Coverage System
      </span>
      <h1 class="font-display font-black text-4xl sm:text-6xl text-white uppercase tracking-tight mb-6">
        Las Vegas Delivery Areas
      </h1>
      <p class="text-gray-300 text-lg leading-relaxed">
        Foodie Fit delivers fresh, chef-cooked meals directly to homes, offices, and apartments throughout Southern Nevada.
      </p>
    </div>

    <!-- Interactive ZIP Code Checker -->
    <div class="bg-dark-card border border-dark-border rounded-3xl p-8 sm:p-12 max-w-2xl mx-auto mb-16 shadow-2xl">
      <h2 class="font-display font-bold text-2xl text-white uppercase mb-2 text-center">Instant ZIP Code Checker</h2>
      <p class="text-xs text-gray-400 text-center mb-6">Enter your 5-digit Las Vegas area ZIP code to confirm delivery eligibility.</p>
      
      <form id="zip-checker-form" class="flex items-center gap-3">
        <input 
          type="text" 
          id="zip-input" 
          placeholder="e.g. 89123" 
          pattern="[0-9]{5}"
          required
          class="flex-1 bg-dark-surface border border-dark-border rounded-xl px-4 py-3 text-base text-white focus:outline-none focus:border-brand-500 font-mono"
        />
        <button type="submit" class="px-6 py-3 rounded-xl font-display font-bold text-sm text-white bg-brand-600 hover:bg-brand-500 shadow-glow-green">
          Check Eligibility
        </button>
      </form>
      <div id="zip-result" class="hidden mt-4 p-4 rounded-xl text-xs font-semibold text-center"></div>
    </div>

    <DirectAnswer 
      question="What areas in Southern Nevada does Foodie Fit deliver to?"
      answer="Foodie Fit delivers across Greater Las Vegas, Henderson, Green Valley, Summerlin, Spring Valley, Enterprise, Paradise, Centennial Hills, Skye Canyon, and North Las Vegas."
    />

    <!-- Neighborhood Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 my-12">
      {areas.map((a) => (
        <a href={a.href} class="bg-dark-card border border-dark-border rounded-2xl p-6 flex flex-col justify-between card-hover-effect group">
          <div>
            <h3 class="font-display font-bold text-lg text-white uppercase group-hover:text-brand-400 transition-colors mb-2">
              {a.name}
            </h3>
            <p class="text-xs text-gray-400 line-clamp-2">{a.zips}</p>
          </div>
          <div class="pt-4 border-t border-dark-border mt-4 text-xs font-bold text-brand-400 flex items-center justify-between">
            <span>View Coverage</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('zip-checker-form') as HTMLFormElement;
  const input = document.getElementById('zip-input') as HTMLInputElement;
  const result = document.getElementById('zip-result');

  const validPrefixes = ['890', '891'];

  if (form && input && result) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const zip = input.value.trim();
      if (zip.length === 5 && validPrefixes.some(p => zip.startsWith(p))) {
        result.className = 'mt-4 p-4 rounded-xl text-xs font-bold text-center bg-brand-500/20 text-brand-300 border border-brand-500/40';
        result.innerHTML = `✓ ZIP Code <strong>${zip}</strong> is eligible for next-day Foodie Fit delivery!`;
      } else {
        result.className = 'mt-4 p-4 rounded-xl text-xs font-bold text-center bg-amber-500/20 text-amber-300 border border-amber-500/40';
        result.innerHTML = `ZIP Code <strong>${zip}</strong> is outside our standard local delivery zone. Store pickup is available at any of our 3 locations.`;
      }
    });
  }
</script>
