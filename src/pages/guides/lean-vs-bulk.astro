---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import DirectAnswer from '../../components/seo/DirectAnswer.astro';
import { ExternalCommerceAdapter } from '../../lib/commerce/external-adapter';

const orderUrl = ExternalCommerceAdapter.getOrderUrl();
---

<BaseLayout
  title="Lean vs Bulk Portion Comparison Guide | Foodie Fit"
  description="Compare Foodie Fit Lean and Bulk portion sizes. Learn which portion option fits your daily protein targets, workout output, and budget."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Lean vs Bulk Guide' }]} />

    <div class="text-center max-w-3xl mx-auto my-12">
      <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-2 block">
        Portion Engineering
      </span>
      <h1 class="font-display font-black text-4xl sm:text-6xl text-white uppercase tracking-tight mb-6">
        Lean vs. Bulk Portions
      </h1>
      <p class="text-gray-300 text-lg leading-relaxed">
        Every signature Foodie Fit meal is available in two distinct portion sizes to match your physical demands.
      </p>
    </div>

    <DirectAnswer 
      question="What is the difference between Foodie Fit Lean and Bulk portion sizes?"
      answer="Lean portions provide standard balanced macros with 35g–48g of protein. Bulk portions increase the meat and protein content by +50% (delivering 55g–75g+ protein per serving) for muscle building or high physical output."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-12">
      <div class="bg-dark-card border border-dark-border rounded-3xl p-8 space-y-4">
        <h2 class="font-display font-bold text-2xl text-white uppercase">Lean Portion</h2>
        <ul class="text-sm text-gray-300 space-y-2">
          <li>• <strong>Protein:</strong> 35g – 48g per meal</li>
          <li>• <strong>Calories:</strong> 330 – 520 kcal</li>
          <li>• <strong>Best For:</strong> Fat loss, maintenance, office lunches</li>
          <li>• <strong>Starting Price:</strong> $8.99 – $12.99</li>
        </ul>
      </div>

      <div class="bg-dark-card border border-brand-500/40 rounded-3xl p-8 space-y-4 bg-brand-950/10">
        <h2 class="font-display font-bold text-2xl text-brand-400 uppercase">Bulk Portion (+50% Meat)</h2>
        <ul class="text-sm text-gray-300 space-y-2">
          <li>• <strong>Protein:</strong> 55g – 75g+ per meal</li>
          <li>• <strong>Calories:</strong> 490 – 760 kcal</li>
          <li>• <strong>Best For:</strong> Hypertrophy, strength training, heavy output</li>
          <li>• <strong>Pricing:</strong> Usually +$2.00 upgrade</li>
        </ul>
      </div>
    </div>

    <div class="text-center py-8">
      <a href={orderUrl} class="px-8 py-4 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-brand-600 to-brand-500 shadow-glow-green hover:scale-105 transition-all">
        Explore Portion Options &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
