---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { ExternalCommerceAdapter } from '../lib/commerce/external-adapter';

const orderUrl = ExternalCommerceAdapter.getOrderUrl();

const bulkItems = [
  { name: 'Bulk Grilled Chicken Breast', unit: 'Per Pound (16 oz)', price: 13.99, protein: '140g P' },
  { name: 'Bulk Lean Sirloin Steak Strips', unit: 'Per Pound (16 oz)', price: 17.99, protein: '152g P' },
  { name: 'Bulk Seasoned Ground Turkey', unit: 'Per Pound (16 oz)', price: 14.49, protein: '144g P' },
  { name: 'Bulk Long-Grain Jasmine Rice', unit: 'Per Pound (16 oz)', price: 6.99, protein: '18g P' },
  { name: 'Bulk Roasted Sweet Potatoes', unit: 'Per Pound (16 oz)', price: 7.99, protein: '12g P' },
  { name: 'Bulk Steamed Garlic Broccoli', unit: 'Per Pound (16 oz)', price: 6.49, protein: '16g P' }
];
---

<BaseLayout
  title="By The Pound Bulk Meal Prep | Foodie Fit Las Vegas"
  description="Buy cooked protein, sweet potatoes, jasmine rice, and vegetables by the pound. Save time and customize your own daily meals."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'By The Pound' }]} />

    <div class="text-center max-w-3xl mx-auto my-12">
      <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-2 block">
        Bulk Prep Ordering
      </span>
      <h1 class="font-display font-black text-4xl sm:text-6xl text-white uppercase tracking-tight mb-6">
        Bulk Meals By The Pound
      </h1>
      <p class="text-gray-300 text-lg leading-relaxed">
        Prefer to portion your own meals at home? Buy pre-cooked lean meats, healthy carbs, and fresh roasted veggies in 1lb containers.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-12">
      {bulkItems.map((b) => (
        <div class="bg-dark-card border border-dark-border rounded-2xl p-6 flex flex-col justify-between card-hover-effect">
          <div>
            <span class="text-xs text-brand-400 font-bold uppercase">{b.unit}</span>
            <h3 class="font-display font-bold text-xl text-white uppercase mb-2">{b.name}</h3>
            <span class="text-xs text-gray-400 font-semibold">{b.protein} Approx.</span>
          </div>
          <div class="pt-4 border-t border-dark-border flex items-center justify-between mt-4">
            <span class="font-display font-bold text-2xl text-white">${b.price.toFixed(2)}</span>
            <a href={orderUrl} class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-brand-600 hover:bg-brand-500 shadow-glow-green">
              Add Bulk Item
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
