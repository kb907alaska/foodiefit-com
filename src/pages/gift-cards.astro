---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { ExternalCommerceAdapter } from '../lib/commerce/external-adapter';

const orderUrl = ExternalCommerceAdapter.getOrderUrl();
---

<BaseLayout
  title="Gift Cards | Foodie Fit Las Vegas"
  description="Give the gift of healthy, fresh, chef-cooked meal prep in Las Vegas. E-gift cards delivered instantly via email."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Gift Cards' }]} />

    <div class="text-center max-w-3xl mx-auto my-12">
      <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-2 block">
        Give The Gift Of Health
      </span>
      <h1 class="font-display font-black text-4xl sm:text-6xl text-slate-900 dark:text-white uppercase tracking-tight mb-6">
        Foodie Fit E-Gift Cards
      </h1>
      <p class="text-slate-600 dark:text-gray-300 text-lg leading-relaxed">
        Perfect for birthdays, busy parents, fitness enthusiasts, or colleagues. Delivered instantly by email or redeemable at any of our three Las Vegas retail stores.
      </p>
    </div>

    <div class="max-w-md mx-auto bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-3xl p-8 text-center space-y-6 shadow-xl transition-colors">
      <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-brand-700 to-brand-500 flex items-center justify-center text-white font-display font-black text-3xl mx-auto shadow-glow-red">
        FF
      </div>
      <h2 class="font-display font-bold text-2xl text-slate-900 dark:text-white uppercase">Digital E-Gift Card</h2>
      <p class="text-sm text-slate-600 dark:text-gray-300">Select any denomination ($25, $50, $100, $250). Never expires and valid for online delivery or in-store grab-and-go.</p>
      <a href={orderUrl} class="w-full inline-block py-4 rounded-xl font-display font-bold text-sm text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow-red hover:scale-105 transition-all">
        Buy Gift Card Now &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
