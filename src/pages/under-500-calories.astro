---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import MealGrid from '../components/menu/MealGrid.astro';
import DirectAnswer from '../components/seo/DirectAnswer.astro';
import { MEALS_DATA } from '../data/meals';
import { ExternalCommerceAdapter } from '../lib/commerce/external-adapter';

const orderUrl = ExternalCommerceAdapter.getOrderUrl();
const lowCalorieMeals = MEALS_DATA.filter(m => m.calories <= 500 && m.calories > 0).slice(0, 16);
---

<BaseLayout
  title="Meals Under 500 Calories | Calorie Controlled Meal Prep Las Vegas"
  description="Explore fresh prepared meals under 500 calories per serving. Precise calorie control with high protein and clean ingredients."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Under 500 Calories' }]} />

    <div class="text-center max-w-3xl mx-auto my-12">
      <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-2 block">
        Caloric Precision Collection
      </span>
      <h1 class="font-display font-black text-4xl sm:text-6xl text-slate-900 dark:text-white uppercase tracking-tight mb-6">
        Meals Under 500 Calories
      </h1>
      <p class="text-slate-600 dark:text-gray-300 text-lg leading-relaxed">
        Satisfying, nutrient-dense prepared meals engineered for weight loss and caloric deficit goals without sacrificing flavor.
      </p>
    </div>

    <DirectAnswer 
      question="How does Foodie Fit maintain high protein in meals under 500 calories?"
      answer="We pair ultra-lean protein cuts (chicken breast, turkey breast, flank steak, shrimp) with voluminous fiber-rich vegetables like cauliflower, asparagus, and zucchini ribbons."
    />

    <div class="my-12">
      <MealGrid meals={lowCalorieMeals} />
    </div>

    <div class="text-center py-8">
      <a href={orderUrl} class="inline-flex items-center justify-center px-8 py-4 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow-red hover:scale-105 transition-all">
        Order Calorie-Controlled Meals &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
