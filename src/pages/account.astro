---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
---

<BaseLayout
  title="Customer Account Portal | Foodie Fit Las Vegas"
  description="Manage your active meal subscriptions, upcoming delivery schedules, order history, and saved favorite meals."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'Account Portal' }]} />

    <div class="max-w-4xl mx-auto my-8 space-y-8">
      
      <!-- Account Header Profile Card -->
      <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-3xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-full bg-brand-500 text-white font-display font-black text-2xl flex items-center justify-center shadow-lg">
            FF
          </div>
          <div>
            <h1 class="font-display font-black text-2xl text-slate-900 dark:text-white uppercase">
              Foodie Fit VIP Member
            </h1>
            <p class="text-xs text-slate-500 dark:text-gray-400">
              Las Vegas Customer • Preferred Pickup: Green Valley Store
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <span class="px-3 py-1 rounded-full bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/30 text-xs font-bold uppercase">
            Active Subscriber
          </span>
        </div>
      </div>

      <!-- Account Dashboard Tabs Matrix -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Active Subscription Box -->
        <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-3xl p-6 space-y-4 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500 dark:text-gray-400 uppercase">Subscription Status</span>
            <span class="w-2 h-2 rounded-full bg-green-500 animate-ping"></span>
          </div>
          <h3 class="font-display font-bold text-xl text-slate-900 dark:text-white uppercase">10 Meals Weekly Plan</h3>
          <p class="text-xs text-slate-600 dark:text-gray-400">Next renewal: Sunday, 6:00 PM PST</p>
          <div class="pt-2 flex gap-2">
            <button class="px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-dark-surface text-xs font-bold text-slate-800 dark:text-gray-200 hover:bg-gray-200">
              Pause Week
            </button>
            <button class="px-3 py-1.5 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 text-xs font-bold hover:bg-brand-500/20">
              Modify Meals
            </button>
          </div>
        </div>

        <!-- Upcoming Delivery Box -->
        <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-3xl p-6 space-y-4 shadow-sm">
          <span class="text-xs font-bold text-slate-500 dark:text-gray-400 uppercase">Next Delivery</span>
          <h3 class="font-display font-bold text-xl text-slate-900 dark:text-white uppercase">Tomorrow Morning</h3>
          <p class="text-xs text-slate-600 dark:text-gray-400">Window: 7:00 AM – 11:00 AM</p>
          <a href="/menu/" class="inline-block text-xs font-bold text-brand-500 hover:underline">
            View 8 Scheduled Items &rarr;
          </a>
        </div>

        <!-- Rewards Points Box -->
        <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-3xl p-6 space-y-4 shadow-sm">
          <span class="text-xs font-bold text-slate-500 dark:text-gray-400 uppercase">Foodie Rewards</span>
          <h3 class="font-display font-bold text-xl text-brand-500 uppercase">450 Points</h3>
          <p class="text-xs text-slate-600 dark:text-gray-400">($10 Off Next Order Available)</p>
          <a href="/rewards-referrals/" class="inline-block text-xs font-bold text-slate-900 dark:text-white hover:underline">
            Redeem Rewards &rarr;
          </a>
        </div>

      </div>

      <!-- Past Orders List -->
      <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-3xl p-6 sm:p-8 space-y-4 shadow-sm">
        <h3 class="font-display font-bold text-lg text-slate-900 dark:text-white uppercase border-b border-gray-200 dark:border-dark-border pb-3">
          Recent Order History
        </h3>

        <div class="space-y-3 text-xs">
          <div class="flex items-center justify-between p-3 rounded-2xl bg-gray-50 dark:bg-dark-surface border border-gray-200 dark:border-dark-border">
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold">Order #FF-89201</strong>
              <span class="text-slate-500">Delivered • July 21, 2026 • 10 Items</span>
            </div>
            <a href="/menu/" class="px-3 py-1.5 rounded-xl bg-brand-600 text-white font-bold hover:bg-brand-500">
              Reorder All &rarr;
            </a>
          </div>

          <div class="flex items-center justify-between p-3 rounded-2xl bg-gray-50 dark:bg-dark-surface border border-gray-200 dark:border-dark-border">
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold">Order #FF-88412</strong>
              <span class="text-slate-500">Store Pickup • July 14, 2026 • 8 Items</span>
            </div>
            <a href="/menu/" class="px-3 py-1.5 rounded-xl bg-brand-600 text-white font-bold hover:bg-brand-500">
              Reorder All &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
