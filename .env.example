# Server-only (Cloudflare Worker / Encrypted Environment Variables)
# Never expose these in client-side bundles!
MPT_API_BASE_URL=https://mptapi20170804072902.azurewebsites.net
MPT_API_KEY=your_production_mpt_api_key_here
MPT_CLIENT_ID=your_mpt_client_id_here
MPT_CLIENT_SECRET=your_mpt_client_secret_here
MPT_WEBHOOK_SECRET=your_hmac_webhook_secret_here

# Safe for browser exposure (Public Client-Side Environment Variables)
PUBLIC_ORDER_URL=https://foodiefit.com/order/
